# Copy to .env and adjust. None of these are secrets — the Canvas token
# lives in the mounted config.toml (data/config/config.toml by default),
# never in this file or in the image.

# Host uid:gid that should own the files u_crawler writes into the mounted
# caldir volume. Match the user who runs `caldir push` on the host, or the
# owner of the bind-mounted directory. `id -u`/`id -g` on the host tell you.
PUID=1000
PGID=1000

# Standard 5-field cron expression (minute hour dom month dow), evaluated in
# TZ below. Default: once a day at 06:00.
CRON_SCHEDULE=0 6 * * *

# Container timezone. Affects both CRON_SCHEDULE evaluation and log
# timestamps.
TZ=UTC

# Run the flow once immediately when the container starts, in addition to
# the daily cron schedule. Leave "true" so a fresh container's first run is
# observable in `docker logs` right away instead of waiting for the next
# cron tick.
RUN_ON_START=true

# Host paths bind-mounted into the container. CONFIG_DIR must contain
# config.toml (with your real Canvas token or token_cmd) before the first
# start. CALDIR_DIR is the caldir tree; it can start empty.
CONFIG_DIR=./data/config
CALDIR_DIR=./data/caldir
